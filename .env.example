# 复制为 .env 后填写（.env 已被 gitignore，不上传）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

DASHSCOPE_API_KEY=sk-xxx          # 百炼：qwen-plus/turbo + text-embedding-v4 共用
DEEPSEEK_API_KEY=                 # 可选：兜底 + vendor analyze 服务

QWEN_MODEL_CHAT=qwen-plus
QWEN_MODEL_ROUTER=qwen-turbo
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

ALLOWED_ORIGINS=http://localhost:5173
MIN_RETRIEVE_SCORE=0.25

# 知识库镜像站（本地镜像：python -m http.server 4310 --directory mirror/site）
# 后端按此地址重写来源链接；线上为 GitHub Pages 镜像（mirror/dist 独立仓库）
# 线上地址：https://lzjzj-creator.github.io
KB_SOURCE_BASE=http://127.0.0.1:4310

# 管理后台（#admin）：首次运行 python ingest/make_admin_password.py 生成
# ADMIN_PASSWORD 仅本地保存，线上只下发哈希与签名密钥
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=7200

# ---- v2 会话/访谈（迁移验收后再开启）----
V2_MEMORY_ENABLED=0        # v2 会话接口总开关（sessions/messages 路由）
COACH_ENABLED=0            # v2 访谈引擎开关（/api/v2/chat/stream）
COACH_MAX_TURNS=12         # 访谈轮数上限
COACH_WRAP_COVERAGE=0.8    # 收尾覆盖率门槛
COACH_WRAP_STAR=0.6        # 收尾 STAR 深度门槛
COACH_THINKING=0           # 深轮开 thinking（首 token +9s，默认关）
COACH_DAILY_TOKEN_BUDGET=200000   # 日 token 预算（进程内近似计数）

# vendor analyze 服务自己部署时用它自己的环境变量，见 vendor-resume-audit/api/server.js
